{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Worker name
  "name": "wep-site",

  "main": "src/worker.js",

  "compatibility_date": "2026-08-01",

  // Static assets served by the same Worker deployment
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/admin*"]
  },

  // Cloudflare D1 database
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-site-analytics",
      "database_id": "05c8111e-94df-450f-9191-ba007cfceec0",
      "migrations_dir": "migrations"
    }
  ]

  // Secrets are configured separately in Cloudflare:
  // ADMIN_TOKEN
  // IP_HASH_SALT
}